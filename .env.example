#APP configurations
APP_NAME=MeterDetective API
APP_ENV=development
APP_DEBUG=false
#DOCKER DB
DATABASE_URL=postgresql+psycopg://meterdetective:meterdetective@db:5432/meterdetective
DATABASE_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_DB=meterdetective
POSTGRES_USER=meterdetective
POSTGRES_PASSWORD=meterdetective
#OPEN-METEO API
WEATHER_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_TIMEOUT_SECONDS=3
WEATHER_RETRY_COUNT=1
WEATHER_CACHE_TTL_SECONDS=3600
DEMO_LATITUDE=31.9539
DEMO_LONGITUDE=35.9106
#LLM 
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=YOUR-API-KEY
LLM_MODEL=YOUR-MODEL
LLM_TIMEOUT_SECONDS=30
# Post-action verification policy
VERIFICATION_MINIMUM_OBSERVATIONS=4
VERIFICATION_BASELINE_PASS_FRACTION=0.75
VERIFICATION_PEER_PASS_FRACTION=0.75
VERIFICATION_PEER_TOLERANCE_FRACTION=0.20
VERIFICATION_POLICY_VERSION=day6-v1
#pgAdmin
pgAdmin_EMAIL=YOUR-PGADMIN_EMAIL
pgAdmin_PASSWORD=YOUR-PGADMIN_PASSWORD

